ARG VLLM_ASCEND_IMAGE=quay.io/atlas-ci/vllm-ascend
ARG VLLM_ASCEND_TAG=v0.23.0
FROM ${VLLM_ASCEND_IMAGE}:${VLLM_ASCEND_TAG}

SHELL ["/bin/bash", "-c"]

ARG APP_DIR=/vllm-workspace/vllm-omni
# Source of the vllm-omni repo to clone into the image (instead of COPY .).
ARG VLLM_OMNI_REPO=https://github.com/vllm-project/vllm-omni.git
ARG VLLM_OMNI_REF=main
# Temporary workaround for the empty Triton namespace directories left in the
# vllm-ascend 310P amd64 image after uninstalling triton and triton-ascend.
ARG PATCH_310P_TRITON_RESIDUE=0

RUN if [[ "${PATCH_310P_TRITON_RESIDUE}" == "1" ]]; then \
        python3 -c 'import shutil, site; from pathlib import Path; [shutil.rmtree(Path(root) / "triton", ignore_errors=True) for root in site.getsitepackages()]' && \
        python3 -c 'import importlib.util; assert importlib.util.find_spec("triton") is None'; \
    fi

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxcb1 \
        espeak-ng && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch ${VLLM_OMNI_REF} ${VLLM_OMNI_REPO} ${APP_DIR}

# Apply v0.21.0 NPU interface fixes at build time (reproducible; safe no-op
# when the code is already aligned, e.g. v0.28.0)
RUN python3 - <<'PYEOF'
patches = [
    ("/vllm-workspace/vllm-omni/vllm_omni/platforms/npu/worker/npu_ar_model_runner.py",
     """                (
                    logits_indices,
                    spec_decode_metadata,
                    total_num_scheduled_tokens,
                ) = self._prepare_inputs(""",
     """                (
                    logits_indices,
                    spec_decode_metadata,
                    total_num_scheduled_tokens,
                    _ascend_extra,
                ) = self._prepare_inputs("""),
    ("/vllm-workspace/vllm-omni/vllm_omni/platforms/npu/worker/npu_model_runner.py",
     "    def _talker_mtp_forward(self, decode_req_ids: list[str], inputs_embeds: torch.Tensor) -> None:",
     "    def _talker_mtp_forward(self, decode_req_ids: list[str], inputs_embeds: torch.Tensor, start_offsets: list[int] | None = None) -> None:"),
    ("/vllm-workspace/vllm-omni/vllm_omni/platforms/npu/worker/npu_generation_model_runner.py",
     """                (
                    logits_indices,
                    spec_decode_metadata,
                    total_num_scheduled_tokens,
                ) = self._prepare_inputs(""",
     """                (
                    logits_indices,
                    spec_decode_metadata,
                    total_num_scheduled_tokens,
                    _ascend_extra,
                ) = self._prepare_inputs("""),
]
for path, old, new in patches:
    try:
        s = open(path).read()
        if old in s:
            open(path, "w").write(s.replace(old, new, 1))
            print("patched:", path)
        else:
            print("skip (already aligned):", path)
    except FileNotFoundError:
        print("skip (missing):", path)
PYEOF

WORKDIR ${APP_DIR}

RUN source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/Ascend/ascend-toolkit/latest/`uname -i`-linux/devlib && \
    if [[ "${PATCH_310P_TRITON_RESIDUE}" == "1" ]]; then python3 -c 'import torch'; fi && \
    python3 -m pip install -U pip && \
    python3 -m pip install -v \
      "pytest>=7.0.0" \
      "pytest-asyncio>=0.21.0" \
      "pytest-cov>=4.0.0" \
      "pytest-mock>=3.10.0" \
      "openpyxl>=3.0.0" \
      "psutil>=7.2.0" \
      "soundfile>=0.13.1" \
      "pyttsx3>=2.99" \
      "opencc==1.4.1" \
      "mindiesd==3.1.0" \
      "opencv-python>=4.12.0.88" \
      "imageio[ffmpeg]>=0.6.0" \
      "jiwer>=3.0.0" \
      "zhon>=2.0.0" \
      "zhconv>=1.4.2" \
      "funasr>=1.0.0" \
      "hyperpyyaml>=1.2.0" \
      "onnx>=1.16.0" \
      "librosa>=0.10.0" \
      "datasets>=3.0.0" \
      --default-timeout=60 && \
    python3 -m pip install -v -e /vllm-workspace/vllm-omni/ --no-build-isolation \
      --default-timeout=60 && \
    python3 -m pip install -v --no-deps \
      "s3tokenizer>=0.3.0" \
      "step-audio2>=1.0.0" \
      --default-timeout=60

ENV VLLM_WORKER_MULTIPROC_METHOD=spawn

ENTRYPOINT []
