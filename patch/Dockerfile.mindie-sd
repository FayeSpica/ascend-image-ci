# Patch an existing image by installing a prebuilt MindIE-SD wheel, then
# re-publish it. Driven by the "Patch image (MindIE-SD)" workflow.
#
#   BASE_IMAGE                    - the source image to patch (declared before FROM)
#   MINDIE_SD_WHEEL_URL_AARCH64   - wheel to install on arm64
#   MINDIE_SD_WHEEL_URL_X86_64    - wheel to install on amd64; empty = skip
#
# mindiesd is on PyPI, but ships exactly one file there
# (mindiesd-3.0.0-cp311-cp311-manylinux_2_34_aarch64.whl): wrong ABI for our
# py3.12 base images, and no x86_64. So wheels are built by the "Build MindIE-SD
# wheel" workflow, hosted as GitHub Release assets, and downloaded here at build
# time. They are deliberately NOT vendored in the repo: at ~62MB each that would
# bloat every clone, and Git LFS meters bandwidth per checkout (once per arch
# runner) whereas public-repo release downloads are unmetered.
#
# One wheel per arch covers both A2 and A3 -- upstream compiles every compute
# unit into it in one pass -- so the only selection here is by `uname -m`,
# matching the platform tag in the wheel's filename. An empty URL for an arch
# skips the install there rather than failing, so both arches still build and
# the multi-arch manifest stays intact.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG MINDIE_SD_WHEEL_URL_AARCH64=https://github.com/FayeSpica/ascend-image-ci/releases/download/mindiesd-3.0.0/mindiesd-3.0.0-cp312-cp312-linux_aarch64.whl
ARG MINDIE_SD_WHEEL_URL_X86_64=

# The download keeps the URL's original filename because pip parses a wheel's
# name/version/tags out of it and rejects anything off-convention.
#
# Verified by metadata rather than `import mindiesd`: the package touches the NPU
# on import and CI runners have no Ascend device.
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
        aarch64) url="${MINDIE_SD_WHEEL_URL_AARCH64}" ;; \
        x86_64)  url="${MINDIE_SD_WHEEL_URL_X86_64}" ;; \
        *)       url="" ;; \
    esac; \
    if [ -z "$url" ]; then \
        echo "no MindIE-SD wheel URL for ${arch}; skipping install"; \
        exit 0; \
    fi; \
    fname="${url##*/}"; \
    echo "downloading ${url}"; \
    if command -v curl >/dev/null 2>&1; then \
        curl -fsSL --retry 3 --retry-delay 5 -o "/tmp/${fname}" "$url"; \
    else \
        wget -q -O "/tmp/${fname}" "$url"; \
    fi; \
    python3 -m pip install --no-cache-dir "/tmp/${fname}"; \
    rm -f "/tmp/${fname}"; \
    python3 -m pip show mindiesd
