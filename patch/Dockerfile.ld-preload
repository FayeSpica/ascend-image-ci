# Patch an existing image by baking a global LD_PRELOAD so libjemalloc is
# preloaded for EVERY process. The vllm-ascend base only sets it in ~/.bashrc
# (login shells), so the vllm server process never picks it up; a Docker ENV
# makes it global.
#
# Referenced by soname (no path) on purpose. The base image's line
#   export LD_PRELOAD=/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2:$LD_PRELOAD
# needs $(uname -m) precisely because the arch-specific path (x86_64- vs
# aarch64-linux-gnu) can't be written as one static string. A Docker ENV can't
# run $(uname -m), and ${TARGETARCH} only yields amd64/arm64 (not the GNU
# triplet), so hardcoding a path would be wrong on one arch. The bare soname
# lets the dynamic linker resolve libjemalloc.so.2 via the ld.so cache to the
# real arch-specific library, so one static value is correct on both arches.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV LD_PRELOAD=libjemalloc.so.2
