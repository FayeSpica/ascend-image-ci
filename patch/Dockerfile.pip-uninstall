# Patch an existing image by uninstalling pip package(s), then re-publish it.
# Driven by the "Patch image (pip uninstall)" workflow via _build_push_image.
#
#   BASE_IMAGE     - the source image to patch (declared before FROM)
#   PIP_UNINSTALL  - space-separated packages to remove
#
# Only a RUN is needed (no COPY of build context), and _build_push_image builds
# each arch on its native runner, so the uninstall executes natively per arch
# with no QEMU emulation.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG PIP_UNINSTALL="mooncake-transfer-engine-npu"
# `pip uninstall -y` exits 0 with a warning if a package is already absent, so
# this is safe even if an arch never had it installed.
RUN python3 -m pip uninstall -y ${PIP_UNINSTALL} && \
    echo "Uninstalled: ${PIP_UNINSTALL}"
